{
  "name": "clavia",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "Aprendé teclado de principiante a avanzado, en tu navegador y sin servicios externos.",
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron .",
    "package:mac": "electron-builder --mac dmg --arm64 --publish never",
    "package:dir": "electron-builder --mac --arm64 --dir",
    "test:ui": "playwright test",
    "test:desktop": "CLAVIA_DESKTOP=1 playwright test tests/ui/desktop.spec.mjs",
    "package:windows": "electron-builder --win nsis --x64 --publish never",
    "package:linux": "electron-builder --linux AppImage deb --x64 --publish never",
    "demo:record": "node scripts/record-demo.mjs",
    "demo:render": "node scripts/render-demo.mjs",
    "vendor": "node scripts/vendor.mjs",
    "privacy:check": "node scripts/audit-public.mjs"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@xmldom/xmldom": "^0.9.12",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0"
  },
  "main": "desktop/main.cjs",
  "author": "Clavia",
  "license": "MIT",
  "build": {
    "appId": "com.clavia.piano",
    "productName": "Clavia",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "style.css",
      "studio.css",
      "*.js",
      "desktop/**",
      "package.json",
      "vendor/**",
      "assets/**",
      "examples/**",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "PRIVACY.md"
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "identity": null,
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "Clavia",
      "artifactName": "Clavia-${version}-mac-${arch}.dmg",
      "contents": [
        {
          "x": 140,
          "y": 180,
          "type": "file"
        },
        {
          "x": 420,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Clavia-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "icon": "build/icon.png",
      "maintainer": "Clavia contributors <115739237+lucionigro@users.noreply.github.com>",
      "artifactName": "Clavia-${version}-linux-${arch}.${ext}"
    },
    "afterPack": "./scripts/verify-package.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lucionigro/Clavia.git"
  },
  "homepage": "https://github.com/lucionigro/Clavia",
  "bugs": {
    "url": "https://github.com/lucionigro/Clavia/issues"
  }
}
